{
  "info": {
    "name": "Alamelmarateb ERP — v1",
    "description": "Catalog + Inventory. Auth: login endpoint pending (identity P7) — paste JWT manually into managerJwt/keeperJwt. Swagger UI: {{baseUrl}}/swagger-ui.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "managerJwt",
      "value": "PASTE_BRANCH_MANAGER_JWT"
    },
    {
      "key": "keeperJwt",
      "value": "PASTE_WAREHOUSE_KEEPER_JWT"
    },
    {
      "key": "warehouseA",
      "value": ""
    },
    {
      "key": "warehouseB",
      "value": ""
    },
    {
      "key": "transferId",
      "value": ""
    },
    {
      "key": "auditId",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "warrantyId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    },
    {
      "key": "adminJwt",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth — public (start here)",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"fullName\": \"Test Customer\", \"phone\": \"01012345678\", \"password\": \"secret123\"}"
            }
          }
        },
        {
          "name": "Login (admin seeded: ADMIN_PHONE/ADMIN_PASSWORD)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"phone\": \"01000000000\", \"password\": \"admin123\"}"
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\": \"REFRESH_TOKEN\"}"
            }
          }
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerJwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Catalog — management (managerJwt)",
      "item": [
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerJwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/catalog/categories",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Mattresses\", \"slug\": \"mattresses\", \"description\": \"All mattresses\"}"
            }
          }
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{managerJwt}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/catalog/products"
          }
