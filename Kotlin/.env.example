# ==============================================================================
# Alam El Marateb Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env or export these variables in your shell.

# Server Configuration
PORT=8080

# Database Configuration (PostgreSQL 16)
DB_URL=jdbc:postgresql://localhost:5432/mydatabase
DB_USER=root
DB_PASSWORD=root

# Redis Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring Session (Redis-backed; API stays JWT stateless)
SESSION_STORE=redis
SESSION_TIMEOUT=86400s

# Transactional Outbox relay
OUTBOX_RELAY_ENABLED=true
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_DELAY_MS=2000
OUTBOX_MAX_ATTEMPTS=10

# Catalog search (Meilisearch; 'none' = Postgres filter fallback)
SEARCH_BACKEND=none
SEARCH_TIMEOUT_MS=2000
MEILI_HOST=http://localhost:7700
MEILI_KEY=dev-master-key
MEILI_INDEX=products

# Partition maintenance + retention (Phase 5)
RETENTION_ENABLED=true
# RETENTION_APP_EVENTS_DAYS=90
# RETENTION_AUDIT_LOGS_DAYS=365

# Read-replica routing (Phase 4: opt-in replica on :5433, else = primary)
# REPLICA_URL=jdbc:postgresql://localhost:5433/mydatabase
# REPLICA_USER=root
# REPLICA_PASSWORD=root

# JWT Authentication (Change JWT_SECRET in production! Minimum 256-bit key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Initial Super Admin Bootstrapping (Used only on first startup by AdminSeeder)
ADMIN_PHONE=01000000000
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Admin

# Domain Events Transport ('in-process' or 'kafka')
EVENTS_TRANSPORT=in-process
KAFKA_BOOTSTRAP=localhost:9092

# Media & Document Storage ('local' or 's3')
STORAGE_BACKEND=local
STORAGE_DIR=./data/uploads
STORAGE_MAX_MB=5

# S3 / MinIO Object Storage (Used when STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=alamelmarateb
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_PUBLIC_BASE=http://localhost:9000/alamelmarateb

# Heavy Analytics Store (ClickHouse)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=alamelmarateb

# Payment Gateways (Paymob & Fawry)
PAYMENTS_FAKE_SECRET=dev-secret
PAYMOB_ENABLED=false
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
FAWRY_ENABLED=false
FAWRY_MERCHANT=
FAWRY_SECRET=

# OAuth2 Social Login (Google & Facebook)
GOOGLE_CLIENT_ID=google-client-id-placeholder
GOOGLE_CLIENT_SECRET=google-client-secret-placeholder
FACEBOOK_CLIENT_ID=facebook-client-id-placeholder
FACEBOOK_CLIENT_SECRET=facebook-client-secret-placeholder
